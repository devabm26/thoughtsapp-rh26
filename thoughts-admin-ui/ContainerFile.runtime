####
# Runtime-only ContainerFile for thoughts-admin-ui
# Use this when you've already built the Vite app locally
# Run: npm run build before building this image
####

FROM registry.access.redhat.com/ubi9/nginx-124:latest

# Copy pre-built Vite application
COPY --chown=1001:0 dist /usr/share/nginx/html

# Copy nginx configuration for SPA routing
COPY <<EOF /etc/nginx/conf.d/default.conf
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files \$uri \$uri/ /index.html;
    }

    # Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}
EOF

EXPOSE 8080

USER 1001

CMD ["nginx", "-g", "daemon off;"]
