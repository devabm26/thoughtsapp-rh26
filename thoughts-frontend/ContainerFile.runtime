####
# Runtime-only ContainerFile for thoughts-frontend
# Use this when you've already built the Next.js app locally
# Run: npm run build before building this image
####

FROM registry.access.redhat.com/ubi9/nodejs-20-minimal:latest

WORKDIR /app

ENV NODE_ENV=production

# Copy pre-built Next.js application
COPY --chown=1001:0 public ./public
COPY --chown=1001:0 .next/standalone ./
COPY --chown=1001:0 .next/static ./.next/static

EXPOSE 3000

USER 1001

CMD ["node", "server.js"]
